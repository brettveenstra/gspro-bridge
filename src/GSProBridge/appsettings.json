{
  "GSPro": {
    "Host": "127.0.0.1",
    "Port": 921,
    "DeviceID": "GSPRO-R10-BRIDGE",
    "HeartbeatIntervalSeconds": 10,
    "ConnectionRetry": {
      "InitialDelay": "00:00:01",
      "MaxDelay": "00:00:30",
      "BackoffType": "Exponential"
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "SamplingDuration": "00:00:10",
      "MinimumThroughput": 5,
      "BreakDuration": "00:00:30"
    },
    "Timeout": {
      "SendTimeout": "00:00:05"
    }
  },
  "R10Bluetooth": {
    "DeviceName": "Approach R10",
    "AutoWake": true,
    "CalibrateTiltOnConnect": true,
    "DebugLogging": false,
    "SendStatusToGSPro": false,
    "ReconnectIntervalSeconds": 5,
    "Environment": {
      "Temperature": 60,
      "Humidity": 0.5,
      "Altitude": 0,
      "AirDensity": 1.0,
      "TeeDistanceFeet": 7
    }
  },
  "Webcam": {
    "Enabled": false,
    "DeviceIndex": 0,
    "HSV": {
      "HMin": 3,
      "HMax": 20,
      "SMin": 181,
      "SMax": 255,
      "VMin": 134,
      "VMax": 255
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gspro-bridge-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ]
  }
}
